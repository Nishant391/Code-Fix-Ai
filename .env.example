# Optional: configure an AI API for deeper debugging and logical bug fixes.
# You can also configure this directly in the website under "AI Settings".

# Google Gemini (Free tier available: https://aistudio.google.com/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Free tier available: https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
